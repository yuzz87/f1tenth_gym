Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Selection
    Name: Selection
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.35
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 120; 120; 120
      Enabled: true
      Name: Grid
      Plane: XY
    - Alpha: 0.8
      Class: rviz_default_plugins/Map
      Color Scheme: map
      Draw Behind: true
      Enabled: true
      Name: Occupancy Map
      Topic: /map
      Update Topic: /map_updates
      Use Timestamp: false
    - Alpha: 1
      Class: rviz_default_plugins/LaserScan
      Color: 0; 255; 255
      Enabled: true
      Name: RPLIDAR A1
      Queue Size: 20
      Size (Pixels): 3
      Style: Points
      Topic: /scan
    - Angle Tolerance: 0.1
      Class: rviz_default_plugins/Odometry
      Enabled: true
      Keep: 200
      Name: Encoder Odometry
      Position Tolerance: 0.02
      Shape:
        Alpha: 1
        Color: 255; 170; 0
        Head Length: 0.1
        Head Radius: 0.04
        Shaft Length: 0.25
        Shaft Radius: 0.02
        Value: Arrow
      Topic: /odom
    - Class: rviz_default_plugins/TF
      Enabled: true
      Frame Timeout: 15
      Name: TF
      Show Axes: true
      Show Names: true
  Enabled: true
  Global Options:
    Background Color: 30; 30; 30
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/Measure
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Top Down
      Scale: 30
Window Geometry:
  Height: 900
  Width: 1400
