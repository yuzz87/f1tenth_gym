[Unit]
Description=Real vehicle standalone UDP actuator agent (dry-run default)
After=network-online.target pigpiod.service
Wants=network-online.target

[Service]
Type=simple
User=@USER@
WorkingDirectory=@INSTALL_DIR@
ExecStart=/usr/bin/python3 @INSTALL_DIR@/agent.py --host 0.0.0.0 --port 5005 --watchdog-timeout 0.20
Restart=on-failure
RestartSec=1
KillSignal=SIGINT
TimeoutStopSec=3

[Install]
WantedBy=multi-user.target
